org.gradle.jvmargs=-Xmx2G
org.gradle.parallel=true

# IntelliJ IDEA is not yet fully compatible with configuration cache, see: https://github.com/FabricMC/fabric-loom/issues/1349
org.gradle.configuration-cache=false

# Fabric Properties
# check these on https://fabricmc.net/develop
# Minecraft ships deobfuscated since 26.1, so there is no mappings artifact.
minecraft_version=26.2
fabric_loader_version=0.19.3
fabric_version=0.157.0+26.2
loom_version=1.17.19
polymer_version=0.17.3+26.2
bil_version=2.1.3+26.2
bil_min_version=2.0.5
fabric_permissions_api_version=0.7.0

# Java toolchain — read by build.gradle, fabric.mod.json and the mixins json. One place to bump.
java_version=25

# Quilt Loader, for the optional `runQuiltServer` task only (see gradle/devserver.gradle / README).
# Quilt has no stable 26.2 release yet, so this tracks the newest actively-updated beta. The rest are
# the loader's runtime libs from its installer manifest (quilt-loader-<ver>.json), which maven
# metadata doesn't expose — keep them in step when bumping quilt_loader_version.
quilt_loader_version=0.31.0-beta.4
quilt_sponge_mixin_version=0.17.4+mixin.0.8.7
quilt_json5_version=1.0.4+final
quilt_config_version=1.3.3
quilt_asm_version=9.10.1
quilt_mixinextras_version=0.5.5

# Dev-server defaults seeded into run/ by configureRunServer (see gradle/devserver.gradle).
# Give a mod sharing a workspace its own ports, outside 25565–25567 (Docker publishes that range).
dev_server_port=25580
dev_rcon_port=25575
dev_rcon_password=dev
# Datapack pack_format for the seeded dev-defaults pack. 107 = MC 26.2; bump with minecraft_version.
dev_datapack_pack_format=107


# Mod Properties
mod_version = 0.1.0
mod_name = CHANGEME
mod_description = CHANGEME
mod_authors = ["CHANGEME"]
mod_website = https://github.com/CHANGEME/CHANGEME
mod_issues = https://github.com/CHANGEME/CHANGEME/issues
mod_license = CHANGEME


# Project Properties
maven_group = club.rainbowkitty.changeme
mod_id = changeme
entrypoint = club.rainbowkitty.changeme.CHANGEME
